{
  "manifest_version": 2,
  "name": "Thunderbird Plus",
  "description": "双击标签页关闭标签，双击标题栏最大化/还原窗口，AI 邮件翻译，左侧备忘录",
  "version": "4.13",
  "author": "AwakerOTE",
  "icons": {
    "16": "icons/thunderbird-plus-16.png",
    "32": "icons/thunderbird-plus-32.png",
    "48": "icons/thunderbird-plus-48.png",
    "64": "icons/thunderbird-plus-64.png",
    "96": "icons/thunderbird-plus-96.png",
    "128": "icons/thunderbird-plus-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-interaction-enhancer@custom",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "storage",
    "messagesRead",
    "messagesModify",
    "accountsRead",
    "mailTabs",
    "menus",
    "clipboardWrite",
    "tabs",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://translation.googleapis.com/*",
    "https://libretranslate.de/*"
  ],
  "browser_action": {
    "default_title": "Thunderbird Plus - 点击打开设置",
    "default_icon": {
      "16": "icons/thunderbird-plus-16.png",
      "32": "icons/thunderbird-plus-32.png",
      "48": "icons/thunderbird-plus-48.png",
      "64": "icons/thunderbird-plus-64.png",
      "96": "icons/thunderbird-plus-96.png",
      "128": "icons/thunderbird-plus-128.png"
    },
    "default_popup": "options/options.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true,
    "browser_style": true
  },
  "message_display_action": {
    "default_title": "Thunderbird Plus",
    "default_popup": "message-action/action.html",
    "default_icon": {
      "16": "icons/thunderbird-plus-16.png",
      "32": "icons/thunderbird-plus-32.png",
      "48": "icons/thunderbird-plus-48.png",
      "64": "icons/thunderbird-plus-64.png",
      "96": "icons/thunderbird-plus-96.png",
      "128": "icons/thunderbird-plus-128.png"
    }
  },
  "experiment_apis": {
    "doubleClickCloseTab": {
      "schema": "schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["doubleClickCloseTab"]],
        "script": "implementation.js"
      }
    }
  }
}
